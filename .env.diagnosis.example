# 设备智诊（Industrial Diagnosis）配置模板
# 复制为 .env.diagnosis 并按需修改；不要提交真实密钥。
# 本版本默认：Fixture 模型 + Mock 数据 + 控制执行禁用。

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
DIAGNOSIS_HOST=127.0.0.1
DIAGNOSIS_PORT=3100
DIAGNOSIS_WEB_DIST=web/dist
DIAGNOSIS_FIXTURES_DIR=fixtures/diagnosis
DIAGNOSIS_LOG_DIR=work/diagnosis/logs
DIAGNOSIS_WORKER_CONCURRENCY=2
DIAGNOSIS_LEASE_MS=30000

# 允许跨域访问诊断 API 的 Origin（逗号分隔）；默认只允许同源/localhost。
# DIAGNOSIS_ALLOWED_ORIGINS=http://127.0.0.1:3100

# 是否允许请求体指定 scenario_id 覆盖（仅演示/评测环境）。
DIAGNOSIS_ALLOW_SCENARIOS=0

# 配置文件路径（默认 ./.env.diagnosis）与加载调试（只打印键名，不打印值）。
# DIAGNOSIS_ENV_FILE=
# DIAGNOSIS_ENV_DEBUG=0

# ---------------------------------------------------------------------------
# 数据模式
# ---------------------------------------------------------------------------
# mock | replay | live
# live 需要已配置的企业只读来源；未配置时 API 返回 409，不会回退 Mock。
DIAGNOSIS_DATA_MODE=mock

# fixture | live
# live 需要下方模型配置；未配置时 Live Eval 标记 NOT_RUN。
DIAGNOSIS_MODEL_MODE=fixture

# 可选：覆盖 MCP 服务入口（默认 packages/industrial-diagnosis-mcp/dist/server.js）。
# DIAGNOSIS_MCP_SERVER=

# ---------------------------------------------------------------------------
# 企业只读 REST 适配器（未配置时来源状态为 UNCONFIGURED）
# ---------------------------------------------------------------------------
# DIAGNOSIS_REST_BASE_URL=https://example.internal/api
# DIAGNOSIS_REST_TOKEN=
# 字段映射与端点模板（JSON）；没有企业文档时不要猜测签名算法。
# resolve 端点用于“测试连接”和设备映射校验，默认 /equipment/resolve。
# DIAGNOSIS_REST_ENDPOINTS={"resolve":"/equipment/resolve","status":"/equipment/{equipment_id}/status"}
# DIAGNOSIS_REST_MAPPING={"status":{"points":"data.points"}}
# DIAGNOSIS_REST_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# 报警 Webhook（HMAC-SHA256）
# 键为 "<workspace_id>:<source_id>" 或 "<source_id>"，值为共享密钥。
# 签名串：timestamp + "." + workspace_id + "." + raw_body
# ---------------------------------------------------------------------------
# DIAGNOSIS_WEBHOOK_SECRETS={"web:main:src-scada":"replace-with-random-secret"}

# ---------------------------------------------------------------------------
# 真实模型（OpenAI 兼容 Chat Completions）
# 未配置时 DIAGNOSIS_MODEL_MODE 必须为 fixture；Live Eval 会标记 NOT_RUN。
# 不要把密钥写入日志、报告或提交到仓库。
# ---------------------------------------------------------------------------
# DeepSeek 示例（OpenAI 兼容）：
# DIAGNOSIS_LLM_BASE_URL=https://api.deepseek.com/v1
# DIAGNOSIS_LLM_MODEL=deepseek-chat
# DIAGNOSIS_LLM_API_KEY=
# DIAGNOSIS_LLM_TIMEOUT_MS=60000
# 可选：仅用于 Eval 的估算成本，不代表供应商账单；未配置时显示 n/a。
# DIAGNOSIS_LLM_INPUT_PRICE_PER_MTOK=
# DIAGNOSIS_LLM_OUTPUT_PRICE_PER_MTOK=

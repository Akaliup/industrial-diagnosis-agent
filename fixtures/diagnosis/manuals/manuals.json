    {
      "document_id": "DOC-NP200-V2-ZH",
      "chunk_id": "ZH-5.2",
      "page": 1,
      "printed_page": "中文摘要 p1",
      "section": "5.2 轴承温度监测",
      "text": "报警阈值为 80 °C。应观察 30 分钟趋势，单点尖峰不足以判定机械故障。",
      "models": [
        "NP-200"
      ],
      "version": "v2"
    },
    {
      "document_id": "DOC-NP200-V2-ZH",
      "chunk_id": "ZH-5.3",
      "page": 2,
      "printed_page": "中文摘要 p2",
      "section": "5.3 温度传感器漂移检查",
      "text": "若轴承温度上升而振动有效值和电机电流保持稳定，应使用手持测温仪对比。偏差超过 5 °C 表明传感器漂移，应更换传感器。",
      "models": [
        "NP-200"
      ],
      "version": "v2"
    },
    {
      "document_id": "DOC-NP200-V2-ZH",
      "chunk_id": "ZH-6.1",
      "page": 3,
      "printed_page": "中文摘要 p3",
      "section": "6.1 振动限值",
      "text": "振动有效值超过 4.5 mm/s 表明机械状态异常。振动上升并伴随电机电流上升提示轴承磨损，应结合油液分析与振动频谱确认。",
      "models": [
        "NP-200"
      ],
      "version": "v2"
    },
    {
      "document_id": "DOC-NP200-V2-ZH",
      "chunk_id": "ZH-7.1",
      "page": 4,
      "printed_page": "中文摘要 p4",
      "section": "7.1 通讯与采样故障",
      "text": "采样缺失、时间戳乱序，或通讯报警已恢复且工艺值正常，表明数据链路故障，不应据此更换机械部件。",
      "models": [
        "NP-200"
      ],
      "version": "v2"
    }
